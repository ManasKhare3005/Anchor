{
  "name": "anchor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "benchmark"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @anchor/extension",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "harness": "npm run harness -w @anchor/benchmark",
    "test:e2e:edge": "npm run test:e2e:edge -w @anchor/extension",
    "benchmark": "npm run benchmark -w @anchor/benchmark",
    "real:fetch": "npm run real:fetch -w @anchor/benchmark",
    "real:propose": "npm run real:propose -w @anchor/benchmark"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
